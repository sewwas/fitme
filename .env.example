# ==============================================================================
# Fit Me Fitness Club Portal — Environment Configuration Example (.env.example)
# ==============================================================================

# Core Django
DJANGO_DEBUG=False
SECRET_KEY=generate-a-strong-random-50-character-key
ALLOWED_HOSTS=*,.onrender.com,fitmefitness.lk,localhost,127.0.0.1
TIME_ZONE=Asia/Colombo
SITE_URL=https://fitmefitness.lk

# Supabase PostgreSQL Database (Production)
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_DATABASE=postgres
DJANGO_DB_USER=postgres.mnpooopfnedpcfrzhlne
DJANGO_DB_PASSWORD=your-supabase-db-password
DJANGO_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DJANGO_DB_PORT=5432

# Biometric & Hardware Bridge
LIVEU_API_URL=https://attapi.liveucloud.com/api/v1
LIVEU_BRANCH_API_KEY=your-liveu-branch-key

# Frontend API URL
NEXT_PUBLIC_API_URL=https://fitme-backend.onrender.com

# Email (Optional)
ENABLE_EMAIL=False
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=your-email-smtp-password
FROM_EMAIL="Fit Me <hello@fitmefitness.lk>"
